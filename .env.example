DATABASE_URL=sqlite:///./runtime/bridge.db
ERP_DATABASE_URL=sqlite:///./runtime/erp.db
UPLOAD_DIR=./runtime/uploads
DEMO_MODE=true
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ERP_BASE_URL=http://127.0.0.1:8001
ERP_TIMEOUT_SECONDS=5

# Frontend build-time setting. Leave empty for the local Vite proxy.
# Set in Railway frontend build environment (or frontend/.env.local locally).
VITE_API_BASE_URL=
# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
